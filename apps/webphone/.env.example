# MIMT Web — copy to .env.local (never commit real values; none of these are secrets).
# API MIMT (Fastify). HTTPS required in production.
VITE_API_URL=https://api.mimt.ca
# TAKATAK OIDC issuer (discovery at /.well-known/openid-configuration) and public client id (PKCE, no secret).
VITE_TAKATAK_ISSUER=https://takatak.ca
VITE_TAKATAK_CLIENT_ID=mimt-web
# 1 = dev-only mock API with fixture data (no backend, no Twilio). Never set in production builds.
VITE_MOCK_API=0
# Free-plan ads (Google AdSense, src/ads/). Public ids, not secrets. Client "ca-pub-" + 16 digits, slots are
# digits. Unset client or banner slot = no ads at all. Plans with "no_ads" and the « Sans pub » add-on never
# see ads. Demo mode (VITE_MOCK_API=1) shows a labelled placeholder instead; set localStorage
# "mimt.demo.plan" = "free" to preview it.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_BANNER=
# Optional desktop sidebar unit.
VITE_ADSENSE_SLOT_SIDEBAR=
