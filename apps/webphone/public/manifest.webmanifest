{
  "id": "/",
  "name": "MIMT Web",
  "short_name": "MIMT",
  "description": "MIMT Web : téléphone, textos, messagerie vocale et portail d'affaires dans votre navigateur. Le 9-1-1 est toujours permis.",
  "lang": "fr-CA",
  "dir": "ltr",
  "start_url": "/messages",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#060D1F",
  "theme_color": "#060D1F",
  "categories": [
    "business",
    "communication",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "url": "/messages",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Appels",
      "url": "/appels",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Messagerie vocale",
      "url": "/messagerie",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/narrow-accueil.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Centre de contrôle : votre numéro, votre disponibilité et ce qui reste à traiter"
    },
    {
      "src": "/screenshots/narrow-messages.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vos textos sur votre numéro canadien"
    },
    {
      "src": "/screenshots/narrow-appels.png",
