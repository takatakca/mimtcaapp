# MIMT Web (app.mimt.ca) — Apache / cPanel (MochaHost) configuration.
# `vite build` copies this file from apps/webphone/public/ into dist/; the FTP deploy uploads it
# (SamKirkland/FTP-Deploy-Action only excludes **/.git* and node_modules by default).
# Every block is guarded by <IfModule>, so a host without a module serves the app instead of a 500.
# Needs AllowOverride FileInfo and mod_headers + mod_rewrite on the host. Check live with:
#   curl -sI https://app.mimt.ca/ | grep -i -E 'strict-transport|content-security|x-frame'

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. HTTP -> HTTPS (301, same host, path and query kept). AutoSSL/ACME challenges stay on HTTP.
  #    X-Forwarded-Proto avoids a redirect loop if TLS is ever terminated by a proxy/CDN in front.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # 2. React Router (BrowserRouter) fallback. Real files (index.html, sw.js, manifest.webmanifest,
  #    robots.txt, mimt-release.json, icons/*, assets/*) are served as they are; only unknown
  #    paths get the app shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Softphone sessions, telephone numbers and OAuth routes must never be framed, indexed or shared
# as referral URLs. Apply only when mod_headers is installed.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  # Stricter than strict-origin-when-cross-origin on purpose: no URL (not even the origin) leaves the app.
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # connect-src: MIMT API, TAKATAK OIDC discovery (VITE_TAKATAK_ISSUER, default https://takatak.ca),
  #   Twilio Voice SDK (signalling wss://*.twilio.com, insights https://eventgw.twilio.com, ring
  #   sounds https://sdk.twilio.com), LiveKit (rtc.mimt.ca self-hosted, or LiveKit Cloud) and the
  #   Supabase Storage signed upload URLs. Add the origin here if VITE_API_URL, the issuer or the
  #   LiveKit host ever move. WebRTC media (ICE/TURN) is not governed by CSP.
  # style-src 'unsafe-inline': LiveKit components and React set inline styles.
  # Google AdSense (free-plan ads, src/ads/): adsbygoogle.js is loaded from pagead2 only for free accounts
  #   and only when VITE_ADSENSE_CLIENT is set; ads render in Google iframes (frame-src) and fetch from the
  #   Google ad origins below (adservice.google.ca for Canadian visitors, adtrafficquality.google for
  #   invalid-traffic checks). Still no 'unsafe-inline' or 'unsafe-eval' for scripts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://www.google.com https://adservice.google.com https://adservice.google.ca https://fundingchoicesmessages.google.com https://*.gstatic.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://www.google.ca https://*.gstatic.com https://*.adtrafficquality.google; media-src 'self' data: blob: https://api.mimt.ca https://*.supabase.co https://sdk.twilio.com https://media.twiliocdn.com https://*.twilio.com; connect-src 'self' https://api.mimt.ca https://takatak.ca https://*.takatak.ca https://*.twilio.com wss://*.twilio.com https://sdk.twilio.com https://media.twiliocdn.com https://rtc.mimt.ca wss://rtc.mimt.ca https://*.livekit.cloud wss://*.livekit.cloud https://*.supabase.co https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://adservice.google.com https://adservice.google.ca https://fundingchoicesmessages.google.com https://*.adtrafficquality.google; worker-src 'self' blob:; manifest-src 'self'; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://www.google.com https://fundingchoicesmessages.google.com https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # App shell and service worker: always revalidated, so a deploy is picked up at once.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|mimt-release\.json|robots\.txt)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Content-hashed Vite output (assets/<name>-<hash>.js|css|…): cache for a year, never revalidate.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
