# MIMT API — copy to .env and fill in. Never commit real values.
# Empty values are treated as unset. In NODE_ENV=production the starred (*) ones are required.

NODE_ENV=development
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0
# * https in production, e.g. https://api.mimt.ca (Twilio signatures are computed on this URL)
PUBLIC_BASE_URL=http://localhost:8080
APP_BASE_URL=https://app.mimt.ca
# Comma-separated. Default: https://mimt.ca,https://app.mimt.ca,https://takatak.ca
CORS_ORIGINS=

# * Supabase Postgres (service role / direct connection). Unset in dev = in-memory store.
DATABASE_URL=

# Twilio (* in production). Use an API Key, not the master auth token, for REST calls.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# * Used only to validate X-Twilio-Signature on webhooks.
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
TWILIO_PUSH_CREDENTIAL_SID_IOS=
TWILIO_PUSH_CREDENTIAL_SID_ANDROID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
# Emergency-enabled company number used as caller ID for 9-1-1 when a user has no number yet.
EMERGENCY_FALLBACK_CALLER_ID=
# Number port-in (landline/VoIP into MIMT). "true" once the Twilio Porting API is enabled on the account.
TWILIO_PORTING_ENABLED=false
# Port-in fee in cents. 0 until the owner approves a fee.
PORT_IN_FEE_CENTS=0
# Optional ops address copied on Twilio porting notifications.
PORT_IN_NOTIFICATION_EMAIL=

# TAKATAK identity and handoff (*)
TAKATAK_ISSUER=
TAKATAK_JWKS_URL=
TAKATAK_CLIENT_ID=
TAKATAK_CLIENT_SECRET=
# Comma-separated allowlist of OAuth redirect URIs (optional; enforced when set).
TAKATAK_REDIRECT_URIS=
TAKATAK_WEBHOOK_URL=
TAKATAK_WEBHOOK_SECRET=
# Key TAKATAK's server sends to /v1/takatak/overview. Set one: the raw key, or its SHA-256 hex.
MIMT_API_KEY=
MIMT_API_KEY_SHA256=

# * Ed25519 private key for MIMT session JWTs: JWK JSON or PKCS#8 PEM (\n escapes allowed).
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(JSON.stringify(generateKeyPairSync('ed25519').privateKey.export({format:'jwk'})))"
MIMT_SESSION_SIGNING_KEY=
# * base64 of 32 random bytes:  openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=

# Stripe (*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

E911_NOTICE_VERSION=2026-10-fr-draft-1
DAILY_SPEND_ALERT_CAD=25
USD_TO_CAD=1.4
INTL_ASSUMED_RATE_CENTS_PER_MIN=50

# Monitoring. Leave empty until the project exists. Never commit real values.
SENTRY_DSN=
# Secret heartbeat URL from Better Stack. Never log it.
BETTER_STACK_HEARTBEAT_URL=

# Cuba (+53) is not on Twilio. Telnyx is the trunk to configure first; voipms is the alternative.
# Hostname only, no user or password.
CUBA_CARRIER=
CUBA_SIP_HOST=

# Private voicemail bucket "voicemail" (not public). Service role key stays here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Store billing and device attestation. Public certificate and package name are not account secrets,
# but the service-account JSON is. Keep all of them in the environment.
APPLE_BUNDLE_ID=ca.mimt.app
APPLE_TEAM_ID=
APPLE_ROOT_CA_PEM=
GOOGLE_PLAY_PACKAGE_NAME=ca.mimt.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# true = a free number requires a successful device attestation.
DEVICE_ATTESTATION_REQUIRED=false
